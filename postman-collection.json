              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "events"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "Published",
                  "description": "Draft | Published | Cancelled | Completed"
                },
                {
                  "key": "from",
                  "value": "2026-01-01",
                  "description": "startDate >= from"
                },
                {
                  "key": "to",
                  "value": "2026-12-31",
                  "description": "startDate <= to"
                },
                {
