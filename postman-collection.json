    {
      "name": "Registrations",
      "item": [
        {
          "name": "List Registrations",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/registrations?eventId={{eventId}}&status=confirmed&q=smith",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "registrations"
              ],
              "query": [
                {
                  "key": "eventId",
                  "value": "{{eventId}}"
                },
                {
                  "key": "courseId",
                  "value": "",
                  "disabled": true
                },
                {
                  "key": "profileId",
                  "value": "",
                  "disabled": true
                },
                {
                  "key": "status",
                  "value": "confirmed",
                  "description": "pending | confirmed | cancelled | attended | no-show"
                },
                {
                  "key": "q",
                  "value": "smith",
                  "description": "matches attendee first/last name or email"
                }
              ]
            },
            "description": "Backs the CRM Attendees grid. Each row also carries approvalStatus (pending_review | processing | approved | rejected) and duplicateReview (status/matchedProfileId/matchSummary) - filter/sort client-side, there's no server-side limit."
          }
        },
        {
          "name": "Get Registrations by Profile (My Events)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/registrations/profile/{{profileId}}?timing=upcoming",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "registrations",
                "profile",
                "{{profileId}}"
              ],
              "query": [
                {
                  "key": "timing",
                  "value": "upcoming",
                  "description": "optional: past | current | upcoming - omit to get all",
                  "disabled": true
                }
              ]
            },
            "description": "Every registration (event or course) for this profile, enriched with: title, startDate, endDate, venue, format (Virtual/In-Person/Hybrid), eventTypeId + eventTypeName (resolved via user-service Lookup), eventCategoryLookupCode, cpdCredits, accreditationBody, certificationType, imageUrl, deliveryMode (courses), parentStatus (the Event/Course's own status), and registered sessions. Each row also gets a computed `timing` field (past/current/upcoming) so the portal can show tabs/sections without extra date math; pass ?timing= to filter server-side instead."
          }
        },
        {
          "name": "Create Registration (single tier / legacy)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"registrationType\": \"event\",\n  \"eventId\": \"{{eventId}}\",\n  \"sessionIds\": [],\n  \"quantity\": 1,\n  \"profile\": {\n    \"profileId\": \"\",\n    \"email\": \"attendee@example.com\",\n    \"firstName\": \"Jane\",\n    \"lastName\": \"Doe\",\n    \"phone\": \"\",\n    \"workLocation\": \"\",\n    \"grade\": \"\",\n    \"nmbiNumber\": \"\",\n    \"addressLine1\": \"\",\n    \"addressLine2\": \"\",\n    \"townCity\": \"\",\n    \"countyState\": \"\",\n    \"eircode\": \"\",\n    \"country\": \"Ireland\"\n  },\n  \"paymentMethod\": \"stripe\",\n  \"registeredVia\": \"crm\",\n  \"registeredByUserId\": \"\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/registrations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "registrations"
              ]
            },
            "description": "profile.profileId is optional - leave blank for a brand-new/not-yet-linked attendee (a server-side duplicate check runs against email/mobile/NMBI (exact) and name/DOB/eircode/address (fuzzy), recorded as duplicateReview on the response) or supply it when the CRM/portal already resolved which existing Profile this is (trusted as CONFIRMED_LINK, no re-scoring). paymentMethod: stripe | invoice | comp | manual. registeredVia: crm | portal | mobile. No Profile is created and no payment is captured/posted by this call - the registration is created at approvalStatus 'pending_review'; see Approve Registration below. This CRM-style request (no stripePaymentIntentId) makes events-service create a fresh manual-capture PaymentIntent itself and return its clientSecret - confirm client-side (stripe.confirmCardPayment) right after. For portal/mobile, which authorize payment directly against account-service BEFORE calling this endpoint, see 'Create Registration (portal/mobile, pre-authorized PaymentIntent)' below instead - never call this shape with an already-authorized intent, it will create a second, unrelated one."
          }
        },
        {
          "name": "Create Registration (portal/mobile, pre-authorized PaymentIntent)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"registrationType\": \"event\",\n  \"eventId\": \"{{eventId}}\",\n  \"sessionIds\": [],\n  \"quantity\": 1,\n  \"profile\": {\n    \"email\": \"attendee@example.com\",\n    \"firstName\": \"Jane\",\n    \"lastName\": \"Doe\"\n  },\n  \"paymentMethod\": \"stripe\",\n  \"registeredVia\": \"portal\",\n  \"stripePaymentIntentId\": \"pi_xxx\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/registrations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "registrations"
              ]
            },
            "description": "Portal/mobile authorize payment directly against account-service (POST /account-service/api/payments/intents with purpose=eventRegistration/courseRegistration, then confirm the card) BEFORE this Registration exists - registrationId can't be included at that point. Pass the already-authorized PaymentIntent's id as stripePaymentIntentId here. createRegistration will NOT create a second PaymentIntent in this case - it verifies the existing payment (tenant/purpose/amount/currency match, and that it isn't already attached to a different registration) via account-service's GET /payments/by-stripe/:paymentIntentId, then backfills registrationId/productCode/eventCategoryCode onto it via POST /payments/intents/:id/attach-registration. The response's payment will be null (no new clientSecret - the caller already has one). Sending stripePaymentIntentId for an intent that doesn't match this registration's amount/currency, or that's already linked to another registration, returns a 400.\n\n IMPORTANT for CPD/course registrations: send registrationType=\"event\" with the CPD event's eventId - there is no separate course registrationType/courseId path in practice (see the Courses folder note). Do not send lineItems from portal/mobile - it bypasses membership/early-bird pricing and is CRM-only; use quantity instead so the amount matches what GET /events/:id/price-quote showed. The amount sent to POST /account-service/api/payments/intents must be integer cents, not euros."
          }
        },
        {
          "name": "Create Registration (multi-tier lineItems, CRM)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"registrationType\": \"event\",\n  \"eventId\": \"{{eventId}}\",\n  \"sessionIds\": [],\n  \"lineItems\": [\n    { \"tierKey\": \"MEMBER\", \"quantity\": 2 },\n    { \"tierKey\": \"STUDENT\", \"quantity\": 1 }\n  ],\n  \"profile\": {\n    \"email\": \"attendee@example.com\",\n    \"firstName\": \"Jane\",\n    \"lastName\": \"Doe\",\n    \"nmbiNumber\": \"\"\n  },\n  \"paymentMethod\": \"manual\",\n  \"registeredVia\": \"crm\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/registrations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "registrations"
              ]
            },
            "description": "lineItems is events-only (not courses) and CRM-only. tierKey is one of MEMBER | NON_MEMBER | EARLY_BIRD_MEMBER | EARLY_BIRD_NON_MEMBER | STUDENT | GROUP_STUDENT. Same deferred profile/payment semantics as the single-tier request above."
          }
        },
        {
          "name": "Check New Attendee Duplicates",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"attendee@example.com\",\n  \"firstName\": \"Jane\",\n  \"lastName\": \"Doe\",\n  \"phone\": \"\",\n  \"nmbiNumber\": \"\",\n  \"addressLine1\": \"\",\n  \"townCity\": \"\",\n  \"countyState\": \"\",\n  \"eircode\": \"\",\n  \"country\": \"Ireland\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/registrations/attendee-duplicate-check",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "registrations",
                "attendee-duplicate-check"
              ]
            },
            "description": "Read-only passthrough to profile-service's exact/fuzzy duplicate scoring - never creates a Profile. Not currently called by createRegistration itself (that runs the same check server-side at intake regardless); this endpoint exists for a caller that wants to pre-check before submitting. email is required. Resolves to { resolution: \"exact\", profileId, membershipNumber } | { resolution: \"review\", candidates: [{ profileId, membershipNumber, name, email, score, classification }] } | { resolution: \"none\" }."
          }
        },
        {
          "name": "Cancel Registration",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/registrations/{{registrationId}}/cancel",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "registrations",
                "{{registrationId}}",
                "cancel"
              ]
            }
          }
        },
        {
          "name": "Approve Registration (create/link profile + capture/post payment)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"decision\": \"LINK\",\n  \"candidateProfileId\": \"\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/registrations/{{registrationId}}/approve",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "registrations",
                "{{registrationId}}",
                "approve"
              ]
            },
            "description": "Only proceeds when the registration is currently approvalStatus 'pending_review' (atomically claimed to 'processing' first, released back to 'pending_review' on failure). Body is only required when duplicateReview.status === 'POTENTIAL_MATCH': decision is 'LINK' (with candidateProfileId - one of duplicateReview.matchSummary's profileId values) or 'CREATE_NEW'. For any other duplicateReview.status (EXACT_MATCH/CONFIRMED_LINK/NO_MATCH) the body is ignored - send {} or omit it. Resolves/creates/links the attendee Profile, captures the authorized Stripe PaymentIntent or posts the recorded manual/comp/invoice payment to the GL, and sets status='confirmed', approvalStatus='approved'."
          }
        },
        {
          "name": "Reject Registration",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/registrations/{{registrationId}}/reject",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "registrations",
                "{{registrationId}}",
                "reject"
              ]
            },
            "description": "Only proceeds when the registration is currently approvalStatus 'pending_review'. No request body. Releases the Stripe authorization (cancelPaymentIntent - no refund, since nothing was captured) or voids the recorded-but-unposted manual/comp/invoice payment, then sets status='cancelled', approvalStatus='rejected', isActive=false and frees the seat. No Profile is ever created/touched by this call."
          }
        }
      ]
    },
